{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gc-parts-api",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "ApiContainer",
      "image": "./Dockerfile",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "ApiContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ApiContainer"] }],
  // Non-secret settings. Secrets (DATABASE_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET,
  // SEED_ADMIN_EMAIL, SEED_ADMIN_PASSWORD, MAKE_WEBHOOK_URL) are set in the Cloudflare dashboard.
  "vars": {
    "NODE_ENV": "production",
    "API_PREFIX": "api",
    "SWAGGER_ENABLED": "false",
    "DATABASE_SSL": "true",
    "RUN_MIGRATIONS": "true",
    "CORS_ORIGINS": "https://karihari-grand-cherokee-parts-hub.gcparts-am.workers.dev",
    "COOKIE_SAME_SITE": "none",
    "COOKIE_SECURE": "true"
  },
  // Keep dashboard-set variables when deploying from Git.
  "keep_vars": true
}

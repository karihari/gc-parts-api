# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=api
SWAGGER_ENABLED=true
# true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
# Browser origins allowed to call the API with cookies (comma separated)
CORS_ORIGINS=http://localhost:8080

# Database: either DATABASE_URL (Neon) ...
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# DATABASE_SSL=true
# ... or the parts below
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gc_parts
TYPEORM_LOGGING=false

# Two different random secrets, at least 32 characters each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Seconds
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=86400
REFRESH_TOKEN_REMEMBER_TTL=2592000

# Cookies. Frontend and API on different sites (e.g. lovable.app + api.gcparts.am)
# need COOKIE_SAME_SITE=none and COOKIE_SECURE=true. Same site: keep lax.
COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.gcparts.am

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# Make.com webhook that forwards orders and contact-form enquiries to the shop
# MAKE_WEBHOOK_URL=

# Used once by `npm run seed` to create the first admin, then remove
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=

# Photo storage in Cloudflare R2 (S3 compatible). Leave all unset to keep photos in the database.
# Set the first four together. R2_PUBLIC_URL is optional: with it, GET /images/:id redirects to
# the bucket's public address (custom domain or r2.dev) so Cloudflare's CDN serves the photo.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://media.gcparts.am
